meta {
  name: Verify document
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/student-documents/{{documentId}}/verify
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "verification_status": "verified"
  }
}

assert {
  res.status: eq 200
  res.body.verification_status: eq verified
}

docs {
  The verifier is taken from the caller, never from the body.
}
