meta {
  name: Create the working Monday
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/api/v1/calendar-days
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "branch_id": "{{branchId}}",
    "calendar_date": "2026-11-02",
    "day_type": "instructional",
    "forenoon_open": true,
    "afternoon_open": true,
    "name": "Monday, full day"
  }
}

assert {
  res.status: eq 201
  res.body.forenoon_open: eq true
  res.body.afternoon_open: eq true
  res.body.day_type: eq instructional
}

script:post-response {
  bru.setEnvVar("calendarDayId", res.body.id);
}

docs {
  2 November 2026 is a Monday, and every slot below is timetabled on day 1, so
  this is the date the rest of the collection marks attendance against.
  Changing it means changing day_of_week on requests 53 to 57 to match - the
  resolver compares the slot's day_of_week with the ISO weekday of the date
  and silently produces nothing when they disagree.

  One row per branch per date. A second POST for the same day answers 409.
}
