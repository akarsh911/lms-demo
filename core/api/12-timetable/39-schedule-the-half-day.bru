meta {
  name: Give the half day its bells
  type: http
  seq: 39
}

post {
  url: {{baseUrl}}/api/v1/calendar-days/{{halfDayId}}/schedules
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "period_scheme_id": "{{schemeId}}",
    "bell_schedule_id": "{{bellScheduleId}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("halfDayScheduleId", res.body.id);
}

docs {
  The added class at request 68 sits on this date. An added deviation is only
  resolved when its period belongs to a scheme that is scheduled on the day,
  so without this row the extra revision class does not appear either.
}
