meta {
  name: Get period 1
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/periods/{{periodOneId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{periodOneId}}
}

docs {
  Reading and writing one period is /periods/{id}, not a path under the
  scheme. The scheme is only in the path where the period is being created or
  listed, because that is where it is needed to place the row.
}
