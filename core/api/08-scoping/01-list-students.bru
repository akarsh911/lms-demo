meta {
  name: List students
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/students
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
}

docs {
  What comes back depends on who is asking. With CAS disabled the
  development subject is unrestricted and sees everything.
}
