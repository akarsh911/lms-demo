meta {
  name: Update grade level
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/v1/grade-levels/{{gradeLevelId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "Class VI",
    "sequence": 6,
    "education_stage": "middle"
  }
}

assert {
  res.status: eq 200
  res.body.name: eq Class VI
  res.body.sequence: eq 6
  res.body.code: eq G6
}

docs {
  sequence is resent unchanged on purpose. It is what promotion walks, so
  editing a grade level is the one place where getting it wrong silently
  reorders a whole school's progression.
}
