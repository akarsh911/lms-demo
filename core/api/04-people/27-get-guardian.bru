meta {
  name: Get guardian
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/api/v1/guardians/{{guardianId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{guardianId}}
  res.body.person_id: eq {{guardianPersonId}}
  res.body.occupation: eq Engineer
  res.body.employer: eq Tata Motors
}

docs {
  The guardian row holds only what is true of the adult regardless of which
  child you are looking at: occupation, employer, status. Everything that is
  true of the pair - father or mother, primary contact, may collect the child,
  may see academics - is on the link, not here, because the same adult can be
  the emergency contact for one child and not the other.

  Their name and phone number are on the person this points at.
}
