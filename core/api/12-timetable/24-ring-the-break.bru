meta {
  name: Ring the break
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/v1/bell-schedules/{{bellScheduleId}}/periods
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "period_id": "{{breakPeriodId}}",
    "start_minute": 625,
    "end_minute": 645
  }
}

assert {
  res.status: eq 201
  res.body.end_minute: eq 645
}

script:post-response {
  bru.setEnvVar("bellPeriodBreakId", res.body.id);
}

docs {
  Without this row the break resolves with start_minute 0, end_minute 0 and
  times_resolved false in the occurrence feed - the period exists, the bell
  does not, and the reader is told so rather than being handed midnight.
}
