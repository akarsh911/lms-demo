meta {
  name: Get subject offering
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/subject-offerings/{{offeringId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{offeringId}}
  res.body.section_id: eq {{sectionId}}
  res.body.edges.subject.code: eq MATH
  res.body.maximum_marks: eq 100
  res.body.pass_marks: eq 33
}

docs {
  The offering is where marks live, not the subject: Maths in 6-A may be out
  of 100 and Maths in 6-B out of 50, and a mark is only meaningful next to the
  maximum it was scored against.
}
