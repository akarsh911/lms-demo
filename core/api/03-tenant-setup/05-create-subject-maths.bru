meta {
  name: Create subject maths
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/subjects
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "Mathematics",
    "short_name": "Maths",
    "code": "MATH",
    "subject_type": "academic",
    "is_elective": false
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("subjectId", res.body.id);
}
