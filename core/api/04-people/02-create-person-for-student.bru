meta {
  name: Create person for student
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/persons
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "cas_user_id": "11111111-1111-4111-8111-111111111111",
    "first_name": "Aarav",
    "last_name": "Sharma",
    "display_name": "Aarav Sharma",
    "date_of_birth": "2014-07-12",
    "email": "aarav@example.com"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("studentPersonId", res.body.id);
  // Kept so request 12 can prove the update path refuses to move it.
  bru.setEnvVar("studentCasUserId", res.body.cas_user_id);
}

docs {
  cas_user_id must already exist in CAS. emerge-core does not mint
  identities implicitly: create the CAS user first, then this row.
}
