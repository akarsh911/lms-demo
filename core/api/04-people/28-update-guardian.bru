meta {
  name: Update guardian
  type: http
  seq: 28
}

patch {
  url: {{baseUrl}}/api/v1/guardians/{{guardianId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "occupation": "Senior Engineer",
    "employer": "Tata Motors Nagpur"
  }
}

assert {
  res.status: eq 200
  res.body.occupation: eq Senior Engineer
  res.body.employer: eq Tata Motors Nagpur
}

docs {
  Nothing here changes what this parent is allowed to see. The flags that do
  are on the link, and request 29 is the route that edits them.

  Sending a person object instead, to correct the parent's phone number, is a
  400 for the same reasons as request 19. PATCH the guardian's person row
  instead, as request 12 does.
}
