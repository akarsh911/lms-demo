meta {
  name: A substitution needs a substitute
  type: http
  seq: 69
}

post {
  url: {{baseUrl}}/api/v1/timetable-deviations
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "timetable_slot_id": "{{slotId}}",
    "deviation_date": "2026-11-16",
    "kind": "substitution",
    "reason": "Someone will cover it."
  }
}

assert {
  res.status: eq 422
}

docs {
  "A class is covered by somebody" is not a fact worth storing. If the cover
  is not arranged yet, the class is cancelled until it is.
}
