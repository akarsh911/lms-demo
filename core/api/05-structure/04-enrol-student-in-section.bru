meta {
  name: Enrol student in section
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/enrollments
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "student_id": "{{studentId}}",
    "academic_session_id": "{{sessionId}}",
    "section_id": "{{sectionId}}",
    "roll_number": "12",
    "enrollment_date": "2026-04-01"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq active
}

script:post-response {
  bru.setEnvVar("enrollmentId", res.body.id);
}

docs {
  One enrolment per student per session. Promotion adds a new row rather than editing this one.
}
