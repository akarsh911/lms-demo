meta {
  name: The holiday is not
  type: http
  seq: 45
}

get {
  url: {{baseUrl}}/api/v1/timetable-calendar/in-session?branch_id={{branchId}}&date=2026-11-03
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.in_session: eq false
}

docs {
  A row exists and both halves are closed. Omitting half asks about the day as
  a whole, and a day is in session if either half is open.
}
