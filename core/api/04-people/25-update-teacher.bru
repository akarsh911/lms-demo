meta {
  name: Update teacher
  type: http
  seq: 25
}

patch {
  url: {{baseUrl}}/api/v1/teachers/{{teacherId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "specialization": "Mathematics and Statistics",
    "qualification_json": [
      {
        "degree": "M.Sc",
        "field": "Mathematics",
        "institution": "Nagpur University",
        "year": 2012
      },
      {
        "degree": "B.Ed",
        "field": "Education",
        "institution": "Nagpur University",
        "year": 2013
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.specialization: eq Mathematics and Statistics
  res.body.qualification_json: length 2
}

docs {
  qualification_json is replaced wholesale, not merged. Send the one new degree
  on its own and the M.Sc is gone. It is a JSON column, so there is no row to
  append to and no way for the server to guess which entry you meant to keep -
  read the teacher first, add to the array, send the whole thing back.

  No inline person object on this route, unlike students, staff and guardians:
  a teacher is created from an existing staff_id, so there is never a new
  identity to mint here.
}
