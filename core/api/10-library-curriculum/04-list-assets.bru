meta {
  name: List assets awaiting bytes
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/library/assets?status=pending&mime_type=application/pdf
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: gte 1
  res.body.page.offset: eq 0
}

docs {
  The filters an operator actually needs: which uploads were promised and never
  arrived. A pending asset older than a day is either a failed upload or a
  client that gave up, and either way it is rubbish holding a storage key.

  A misspelt filter is a 400, not an ignored parameter. Silently dropping
  status here would return every asset under a heading that says pending.
}
