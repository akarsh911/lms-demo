meta {
  name: List staff
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/v1/staff?branch_id={{branchId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.school: eq {{schoolCode}}
  res.body.staff: isArray
  res.body.count: gte 1
}

docs {
  Filtered to the branch this run created, which is how a multi-branch school
  reads its own staff list.

  Other filters: q, department_id, status, and teaching=true, which narrows to
  the staff who also have a teacher record. That last one is the cheap way to
  answer "who can be assigned to a class" without walking /teachers and
  resolving each staff_id.
}
