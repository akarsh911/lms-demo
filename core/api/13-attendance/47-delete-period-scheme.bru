meta {
  name: Delete the period scheme
  type: http
  seq: 47
}

delete {
  url: {{baseUrl}}/api/v1/period-schemes/{{schemeId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 204
}

docs {
  Last of the day-shape rows, because the timetable, the periods and the bell
  schedules all point at it. Attempting it while any of them still exists is
  409, which is the usual sign that a delete further up the folder failed and
  was not noticed.
}
