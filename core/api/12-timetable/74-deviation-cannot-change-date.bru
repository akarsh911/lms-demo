meta {
  name: A deviation cannot change date
  type: http
  seq: 74
}

patch {
  url: {{baseUrl}}/api/v1/timetable-deviations/{{cancelledDeviationId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "deviation_date": "2026-11-16"
  }
}

assert {
  res.status: eq 422
}

docs {
  With timetable_slot_id, section_id and period_id. A deviation is a statement
  about one class on one day; changing the day makes it a statement about a
  different class, and the class it used to be about silently goes back to
  normal.
}
