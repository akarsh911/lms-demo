headers {
  Content-Type: application/json
}

auth {
  mode: none
}

script:pre-request {
  // Send a bearer token only when one is set. With CAS_BASE_URL empty the API
  // runs with a development subject and needs no token at all.
  const token = bru.getEnvVar("token");
  if (token) {
    req.setHeader("Authorization", "Bearer " + token);
  }
}
