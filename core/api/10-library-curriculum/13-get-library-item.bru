meta {
  name: Get textbook
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/library/{{libraryItemId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{libraryItemId}}
  res.body.asset_id: eq {{assetId}}
  res.body.index_status: eq none
}

docs {
  An item the caller may not read is 404, never 403. A 403 would confirm that
  the id is real, and walking the id space is exactly what the audience rules
  exist to stop.

  index_status none and a null engine_document_id are the honest state of an
  item that has never been sent to the retrieval engine. Nothing here has been:
  indexing sits behind RETRIEVAL_INDEX_ENABLED and that flag is off.
}
