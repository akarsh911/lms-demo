meta {
  name: Update branch
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/api/v1/branches/{{branchId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "phone": "+91-712-2345678",
    "email": "main@dps-ngp.example"
  }
}

assert {
  res.status: eq 200
  res.body.phone: eq +91-712-2345678
  res.body.email: eq main@dps-ngp.example
  res.body.code: eq MAIN
  res.body.address_json.city: eq Nagpur
}

docs {
  A PATCH here is genuinely partial: address_json is absent from the body and
  survives untouched. Sending it would replace the whole document, not merge
  into it, so a caller that wants to change one line must send the whole
  address back.
}
