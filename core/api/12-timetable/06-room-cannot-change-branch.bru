meta {
  name: A room cannot move branch
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/rooms/{{roomId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "branch_id": "{{branchId}}"
  }
}

assert {
  res.status: eq 422
}

docs {
  Refused even when the branch sent is the one the room is already in. The
  check is on the field being present, not on the value differing, because the
  alternative is a room that silently moves campus and takes a term of
  timetabled classes with it.
}
