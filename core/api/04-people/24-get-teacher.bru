meta {
  name: Get teacher
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/api/v1/teachers/{{teacherId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{teacherId}}
  res.body.staff_id: eq {{staffId}}
  res.body.teacher_code: eq TCH-0001
  res.body.specialization: eq Mathematics
}

docs {
  staff_id, not person_id: the chain is teacher to staff to person, and it is
  the staff row that request 22 promoted.

  specialization is what this teacher is qualified in. What they actually teach
  this session is a teacher assignment, in folder 06, and the two are allowed
  to disagree - the Mathematics specialist covering a Physics section is a
  normal week in a school, not a data error.
}
