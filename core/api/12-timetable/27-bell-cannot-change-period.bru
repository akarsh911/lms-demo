meta {
  name: A bell cannot change period
  type: http
  seq: 27
}

patch {
  url: {{baseUrl}}/api/v1/bell-schedule-periods/{{bellPeriodTwoId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "period_id": "{{breakPeriodId}}",
    "start_minute": 590,
    "end_minute": 630
  }
}

assert {
  res.status: eq 422
}

docs {
  Repointing a bell at a different period would move every class timetabled
  into that period without touching a single slot. Delete the bell and ring
  the other period instead.
}
