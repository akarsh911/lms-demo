meta {
  name: Create person for guardian
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/persons
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "cas_user_id": "33333333-3333-4333-8333-333333333333",
    "first_name": "Rohit",
    "last_name": "Sharma",
    "display_name": "Rohit Sharma",
    "phone": "+91-9800000000"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("guardianPersonId", res.body.id);
}
