meta {
  name: Create student
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/students
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "person_id": "{{studentPersonId}}",
    "admission_number": "ADM-2026-0001",
    "admission_date": "2026-04-01",
    "house_id": "{{houseId}}"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq active
}

script:post-response {
  bru.setEnvVar("studentId", res.body.id);
}

docs {
  No class or section here. Those are session-scoped and live on the enrolment.
}
