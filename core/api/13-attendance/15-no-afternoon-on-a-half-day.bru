meta {
  name: No afternoon on a half day
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/attendance/days
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "student_id": "{{studentId}}",
    "section_id": "{{sectionId}}",
    "attendance_date": "2026-11-04",
    "afternoon_status": "absent"
  }
}

assert {
  res.status: eq 422
  res.body.message: contains attendance_not_in_session
}

docs {
  The sports meet closes at lunch, so there is no afternoon to be absent from.
  Marking a pupil absent from a half of a day the school itself shut would put
  a real absence in a real report on the strength of a school holiday.
}
