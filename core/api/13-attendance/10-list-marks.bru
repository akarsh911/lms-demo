meta {
  name: November, mark by mark
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/attendance/periods?student_id={{studentId}}&from=2026-11-01&to=2026-11-30
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 1
  res.body.attendance_periods: isArray
}

docs {
  Narrows by student_id, subject_offering_id, period_id, timetable_slot_id,
  academic_session_id, status and a date window. Filtering by status=absent
  over a term is the query a pastoral report is built from; filtering by
  timetable_slot_id is how a teacher finds their own class's history.
}
