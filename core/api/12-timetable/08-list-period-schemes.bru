meta {
  name: List period schemes
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/period-schemes?branch_id={{branchId}}&academic_session_id={{sessionId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: gte 1
  res.body.period_schemes: isArray
}
