meta {
  name: Create the classroom
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/rooms
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "branch_id": "{{branchId}}",
    "name": "Room 12",
    "code": "R-12",
    "room_type": "classroom",
    "building": "Main block",
    "floor": "1",
    "capacity": 45
  }
}

assert {
  res.status: eq 201
  res.body.code: eq R-12
  res.body.status: eq active
}

script:post-response {
  bru.setEnvVar("roomId", res.body.id);
}

docs {
  code is unique within the branch, so a second run against a tenant that was
  not cleaned up answers 409 "that value is already taken" rather than
  creating a second Room 12. That is the usual sign that folder 13's teardown
  did not finish.

  room_type is free text, not an enum - "classroom", "laboratory", "hall" are
  conventions, not a closed list, and the filter on request 03 matches it
  exactly.
}
