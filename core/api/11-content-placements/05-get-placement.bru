meta {
  name: Get placement
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/placements/{{placementId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{placementId}}
  res.body.page_start: eq 12
  res.body.page_end: eq 28
  res.body.confirmed_by: isUndefined
}

docs {
  Still proposed, so confirmed_by and confirmed_at are absent rather than null:
  a nillable field that was never set is left out of the body entirely, which
  is worth knowing before writing a client that tests for null.

  Those two fields and status are one statement -- who agreed, when, and that
  it is agreed at all -- and the API keeps them in step rather than letting a
  caller move one without the others.
}
