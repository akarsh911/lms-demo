meta {
  name: Create staff
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/staff
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "person_id": "{{teacherPersonId}}",
    "employee_code": "EMP-0001",
    "designation": "Senior Teacher",
    "employment_type": "full_time",
    "branch_id": "{{branchId}}",
    "joining_date": "2020-06-01"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("staffId", res.body.id);
}
