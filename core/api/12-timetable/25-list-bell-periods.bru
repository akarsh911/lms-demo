meta {
  name: List the bells
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/v1/bell-schedules/{{bellScheduleId}}/periods
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 3
  res.body.bell_schedule_periods: isArray
}
