meta {
  name: Link guardian to student
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/guardians/{{guardianId}}/students
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "student_id": "{{studentId}}",
    "relationship_type": "father",
    "is_primary": true,
    "is_emergency_contact": true,
    "can_pickup": true,
    "can_view_academic": true,
    "can_view_finance": false
  }
}

assert {
  res.status: eq 201
  res.body.can_view_finance: eq false
}

script:post-response {
  bru.setEnvVar("studentGuardianId", res.body.id);
}

docs {
  The flags are authorization decisions, not UI hints. can_view_finance
  is false here, so this parent may see academics but not the fee ledger.
}
