meta {
  name: Delete the caller person
  type: http
  seq: 25
}

delete {
  url: {{baseUrl}}/api/v1/persons/{{callerPersonId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 204
}

docs {
  The person row created so the caller could be attributed as an author and an
  owner. It goes after everything that names it and before the other person
  deletes, which is why it is here rather than beside them.
}
