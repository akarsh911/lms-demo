meta {
  name: List grade levels
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/grade-levels?active=true
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.grade_levels[0].status: eq active
  res.body.page.limit: eq 50
  res.body.page.offset: eq 0
}

docs {
  Ordered by sequence, which is the promotion order rather than the name:
  "Class 10" sorts before "Class 9" alphabetically and after it in a school.
}
