meta {
  name: Swap the bells for the day
  type: http
  seq: 41
}

patch {
  url: {{baseUrl}}/api/v1/calendar-day-schedules/{{dayScheduleId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "bell_schedule_id": "{{bellScheduleId}}"
  }
}

assert {
  res.status: eq 200
  res.body.bell_schedule_id: eq {{bellScheduleId}}
}

docs {
  bell_schedule_id is the only field an update may carry, and it is required
  rather than optional: the point of this row is which bells ring, so an empty
  body is 400. period_scheme_id and calendar_day_id are refused 422 - a day
  that changed scheme would change which slots resolve on it, which is a new
  schedule, not an edit of this one.
}
