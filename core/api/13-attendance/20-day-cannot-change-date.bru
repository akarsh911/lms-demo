meta {
  name: A day cannot change date
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/api/v1/attendance/days/{{attendanceDayId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "attendance_date": "2026-11-09"
  }
}

assert {
  res.status: eq 422
}

docs {
  With student_id, section_id and academic_session_id. Moving a day mark would
  move an absence onto a date the pupil was never marked for, and off a date
  the school has already reported on.
}
