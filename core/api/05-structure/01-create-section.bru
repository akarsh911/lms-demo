meta {
  name: Create section
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/sections
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "branch_id": "{{branchId}}",
    "grade_level_id": "{{gradeLevelId}}",
    "name": "A",
    "code": "6-A",
    "capacity": 40
  }
}

assert {
  res.status: eq 201
  res.body.code: eq 6-A
  res.body.capacity: eq 40
}

script:post-response {
  bru.setEnvVar("sectionId", res.body.id);
}

docs {
  A section belongs to one session: 6-A in 2026-27 and 6-A in 2027-28 are
  different rows, which is why academic_session_id is required and not
  inferred from whichever session happens to be current.

  No class teacher yet. 05/10 appoints one once 04 has created the teacher.
}
