meta {
  name: Excuse the afternoon
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/api/v1/attendance/days/{{attendanceDayId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "afternoon_status": "excused",
    "remarks": "Guardian collected her at 13:40."
  }
}

assert {
  res.status: eq 200
  res.body.afternoon_status: eq excused
  res.body.forenoon_status: eq present
}

docs {
  The forenoon is untouched: each half is set only when it is sent, so
  correcting the afternoon cannot silently overwrite a morning somebody else
  recorded.

  Unlike the create, an update does not re-check whether the half is in
  session. A day closed after the fact - a strike called at noon - can still
  have its marks corrected rather than being frozen by the calendar change.
}
