meta {
  name: List the teaching periods
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/period-schemes/{{schemeId}}/periods?kind=teaching
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 2
  res.body.periods[0].code: eq P1
  res.body.periods[1].code: eq P2
}

docs {
  Ordered by sequence, then by id where sequences tie. The break is filtered
  out by kind, not by its sequence - there is nothing structural marking it as
  non-teaching other than the enum.
}
