meta {
  name: Create the break
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/period-schemes/{{schemeId}}/periods
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "Short break",
    "code": "BRK",
    "sequence": 3,
    "kind": "break"
  }
}

assert {
  res.status: eq 201
  res.body.kind: eq break
}

script:post-response {
  bru.setEnvVar("breakPeriodId", res.body.id);
}

docs {
  A break is a period like any other. It occupies a place in the sequence and
  gets a bell, which is what stops the timetable from treating the gap as
  teachable time and scheduling a class across it.
}
