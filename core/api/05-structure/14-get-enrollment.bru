meta {
  name: Get enrollment
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/enrollments/{{enrollmentId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{enrollmentId}}
  res.body.status: eq active
  res.body.roll_number: eq "12"
  res.body.edges.section.code: eq 6-A
}

docs {
  Unlike a section, an enrolment names a pupil, so this read is narrowed: a
  restricted caller only reaches the row if the student behind it is one they
  may see. When they may not, the answer is 404 and not 403, so that trying
  ids at random tells an outsider nothing.
}
