meta {
  name: Reword the period scheme
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/period-schemes/{{schemeId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "description": "Two teaching periods, then a short break."
  }
}

assert {
  res.status: eq 200
  res.body.code: eq REG
}

docs {
  academic_session_id and branch_id are refused here with 422. Moving a scheme
  between sessions would silently re-date every timetable built on it.
}
