meta {
  name: Only the open forenoons
  type: http
  seq: 43
}

get {
  url: {{baseUrl}}/api/v1/timetable-calendar?branch_id={{branchId}}&from=2026-11-01&to=2026-11-30&half=forenoon&open_only=true
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 3
  res.body.half: eq forenoon
}

docs {
  The half day survives this filter and the holiday does not: its forenoon is
  open even though its afternoon is shut. Asking the same question with
  half=afternoon drops it, which is the shape a bus roster or a midday meal
  count actually needs.
}
