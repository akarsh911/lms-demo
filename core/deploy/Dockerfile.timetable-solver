# syntax=docker/dockerfile:1

FROM python:3.12-slim AS base
WORKDIR /srv

COPY tools/timetable-solver/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir "$(grep -E '^ortools==' requirements.txt)"

COPY tools/timetable-solver/timetable_solver ./timetable_solver
COPY tools/timetable-solver/server.py ./server.py

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin solver
USER solver

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TIMETABLE_SOLVER_BIND=0.0.0.0 \
    TIMETABLE_SOLVER_PORT=8099

EXPOSE 8099
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8099/healthz', timeout=2).status == 200 else 1)"

ENTRYPOINT ["python", "server.py"]
