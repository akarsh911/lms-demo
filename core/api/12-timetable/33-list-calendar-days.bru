meta {
  name: List November
  type: http
  seq: 33
}

get {
  url: {{baseUrl}}/api/v1/calendar-days?branch_id={{branchId}}&from=2026-11-01&to=2026-11-30
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 4
  res.body.calendar_days: isArray
}

docs {
  from and to are inclusive and either may be given alone. to before from is
  refused 400 rather than returning nothing.
}
