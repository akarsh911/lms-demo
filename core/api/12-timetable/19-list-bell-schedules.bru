meta {
  name: List bell schedules
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/v1/period-schemes/{{schemeId}}/bell-schedules
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 1
  res.body.bell_schedules: isArray
}
