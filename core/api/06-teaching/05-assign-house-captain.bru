meta {
  name: Assign house captain
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/student-assignments
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "student_id": "{{studentId}}",
    "role_type": "house_captain",
    "valid_from": "2026-04-01"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("houseCaptainAssignmentId", res.body.id);
}

docs {
  No section_id. A house captain answers to a house, not to one section, so
  the column is nullable and a null means the role is wider than a section.
}
