meta {
  name: A slot must say what it is
  type: http
  seq: 58
}

post {
  url: {{baseUrl}}/api/v1/timetables/{{timetableId}}/slots
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "section_id": "{{sectionId}}",
    "period_id": "{{periodTwoId}}",
    "day_of_week": 2
  }
}

assert {
  res.status: eq 422
}

docs {
  A slot with neither an offering nor a label is a blocked-out period nobody
  can explain, and it would show up in a pupil's day as an unexplained gap
  that is not free time.
}
