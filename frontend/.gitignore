node_modules/
.next/
out/
build/
.DS_Store
*.pem
.env
.env.local
.env*.local
npm-debug.log*
next-env.d.ts
.vercel
*.tsbuildinfo

# Compiled output that lands NEXT TO its own source.
# `tsc` without --noEmit writes src/constants/cas.js beside cas.ts, and a plain
# `git add -A` then commits a stale copy of every file it touched. Nothing under
# src/ is authored as .js, so this can be absolute.
src/**/*.js
src/**/*.js.map
src/**/*.d.ts

# Raw backend responses captured by RECORD_FIXTURES=1. Real people, never commit.
.fixtures-raw/

# GRASP demo store, written at run time.
.grasp-data/
.demo-logs/
