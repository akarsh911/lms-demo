meta {
  name: Update school house
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/api/v1/school-houses/{{houseId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "display_config_json": {
      "colour": "#0F8B5C",
      "sort_order": 2,
      "motto": "Fortis et Fidelis"
    }
  }
}

assert {
  res.status: eq 200
  res.body.display_config_json.sort_order: eq 2
  res.body.display_config_json.motto: eq Fortis et Fidelis
  res.body.code: eq EMR
}

docs {
  display_config_json is replaced wholesale, so colour is resent even though
  it has not changed. Leaving it out would drop it. A house carries no rules,
  only presentation, which is why the whole thing is one open document rather
  than columns.
}
