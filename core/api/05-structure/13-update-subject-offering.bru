meta {
  name: Update subject offering
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/api/v1/subject-offerings/{{electiveOfferingId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "periods_per_week": 4,
    "maximum_marks": 100,
    "pass_marks": 40
  }
}

assert {
  res.status: eq 200
  res.body.periods_per_week: eq 4
  res.body.pass_marks: eq 40
  res.body.maximum_marks: eq 100
}

docs {
  maximum_marks is resent even though it has not changed, and that is the
  point. The pass-below-maximum rule that 09/06 proves on create is checked
  between the two values in the body, not against the row already stored, so a
  PATCH carrying pass_marks alone is accepted whatever the stored maximum is.
  Send the pair or send neither.
}
