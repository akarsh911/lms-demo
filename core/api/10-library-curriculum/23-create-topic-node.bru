meta {
  name: Create topic under the unit
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/curricula/{{curriculumId}}/nodes
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "kind": "topic",
    "title": "Prime factorisation",
    "sequence": 1,
    "parent_id": "{{curriculumUnitId}}",
    "description": "Factor trees, HCF and LCM."
  }
}

assert {
  res.status: eq 201
  res.body.kind: eq topic
  res.body.parent_id: eq {{curriculumUnitId}}
}

script:post-response {
  bru.setEnvVar("curriculumTopicId", res.body.id);
}

docs {
  The node folder 11 maps content onto, and the one worth watching: it is a
  child, so resolving it with include_ancestors=true also picks up whatever was
  placed against the unit above it and against the curriculum as a whole.

  parent_id must name a node of this same curriculum -- 422 otherwise. Parents
  across syllabuses would make the tree a graph spanning two subjects, and
  every walk up it would leave the syllabus it started in. On update there is a
  second check for cycles, so a node cannot be made a child of its own
  descendant and strand the whole branch.
}
