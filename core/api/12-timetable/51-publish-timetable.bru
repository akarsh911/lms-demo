meta {
  name: Publish it
  type: http
  seq: 51
}

patch {
  url: {{baseUrl}}/api/v1/timetables/{{timetableId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "status": "published"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq published
  res.body.published_at: isDefined
}

docs {
  published_at is stamped by the server the moment the status becomes
  published, and published_by is taken from the caller. Neither may be sent.

  Publishing does not freeze the slots. A published timetable still accepts
  slot edits, and the clash checker treats published and draft slots alike, so
  "published" is an editorial state for the people reading it rather than a
  lock.
}
