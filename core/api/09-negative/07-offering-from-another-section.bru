meta {
  name: Offering from another section
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/subject-enrollments
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "student_enrollment_id": "{{enrollmentId}}",
    "subject_offering_id": "44444444-4444-4444-8444-444444444444"
  }
}

assert {
  res.status: eq 404
}

docs {
  A pupil cannot be enrolled in a subject belonging to a different section.
}
