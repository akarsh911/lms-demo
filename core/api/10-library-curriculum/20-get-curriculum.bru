meta {
  name: Get curriculum
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/v1/curricula/{{curriculumId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{curriculumId}}
  res.body.board: eq CBSE
  res.body.grade_level_id: eq {{gradeLevelId}}
}

docs {
  A teacher may read the curricula for the subjects and grades they teach; the
  reach is worked out from their assignments, not from a flag on the row. One
  they do not teach is 404 rather than 403, for the same reason as everywhere
  else: a 403 tells the caller the id is real.
}
