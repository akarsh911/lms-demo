meta {
  name: Monday's slots
  type: http
  seq: 59
}

get {
  url: {{baseUrl}}/api/v1/timetables/{{timetableId}}/slots?day_of_week=1
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 4
  res.body.timetable_slots: isArray
}

docs {
  day_of_week, section_id, teacher_id, room_id and subject_offering_id all
  narrow this list. day_of_week=0 is refused 400 rather than being treated as
  "no filter", because zero is exactly what a client that forgot ISO numbering
  would send.
}
