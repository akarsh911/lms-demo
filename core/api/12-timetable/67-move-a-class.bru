meta {
  name: Move a class to another room
  type: http
  seq: 67
}

post {
  url: {{baseUrl}}/api/v1/timetable-deviations
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "timetable_slot_id": "{{slotId}}",
    "deviation_date": "2026-11-02",
    "kind": "room_change",
    "room_id": "{{roomId}}",
    "reason": "The laboratory is being used for the science fair."
  }
}

assert {
  res.status: eq 201
  res.body.kind: eq room_change
  res.body.room_id: eq {{roomId}}
}

script:post-response {
  bru.setEnvVar("roomChangeId", res.body.id);
}

docs {
  This is what puts the maths occurrence on 2 November into state "relocated"
  rather than "planned" at request 75. The five kinds are cancelled,
  substitution, room_change, time_change and added, and each has its own
  required field: a substitution needs a substitute, a room change needs a
  room, a time change needs both minutes.
}
