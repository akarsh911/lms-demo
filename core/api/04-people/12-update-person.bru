meta {
  name: Update person
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/persons/{{studentPersonId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "display_name": "Aarav R. Sharma",
    "phone": "+91-9800000001",
    "cas_user_id": "99999999-9999-4999-8999-999999999999"
  }
}

assert {
  res.status: eq 200
  res.body.display_name: eq Aarav R. Sharma
  res.body.phone: eq +91-9800000001
  res.body.cas_user_id: eq {{studentCasUserId}}
}

docs {
  Two things to notice.

  cas_user_id is sent here and ignored. Re-pointing an existing person at a
  different CAS identity is an account takeover, not an edit, so the update
  path simply does not carry the field. It is not rejected either, which is
  the trap: a 200 does not mean every key in your body was applied.

  Fields you omit are left alone, and fields your policy does not cover are
  refused outright with a 403 naming them, rather than being silently dropped.
  That is the opposite treatment from cas_user_id above: one is not writable
  by anyone, the other is not writable by you.
}
