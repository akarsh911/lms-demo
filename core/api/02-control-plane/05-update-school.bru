meta {
  name: Update school
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/schools/{{schoolId}}
  body: json
  auth: inherit
}

body:json {
  {
    "city": "Nagpur",
    "website": "https://dps-nagpur.example"
  }
}

assert {
  res.status: eq 200
}

docs {
  code is immutable and is not accepted here.
}
