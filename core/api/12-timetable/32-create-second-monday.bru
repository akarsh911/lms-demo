meta {
  name: Create the second Monday
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/api/v1/calendar-days
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "branch_id": "{{branchId}}",
    "calendar_date": "2026-11-09",
    "day_type": "instructional",
    "forenoon_open": true,
    "afternoon_open": true,
    "name": "Monday, full day"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("cancelledDayId", res.body.id);
}

docs {
  A second Monday, in session and fully open, so that the cancellation at
  request 65 is the only reason a class does not run on it. Without a second
  working Monday the difference between "closed" and "cancelled" cannot be
  told apart in folder 13's refusals.
}
