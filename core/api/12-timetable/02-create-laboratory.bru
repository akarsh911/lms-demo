meta {
  name: Create the laboratory
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/rooms
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "branch_id": "{{branchId}}",
    "name": "Physics laboratory",
    "code": "LAB-P",
    "room_type": "laboratory",
    "capacity": 30
  }
}

assert {
  res.status: eq 201
  res.body.code: eq LAB-P
}

script:post-response {
  bru.setEnvVar("labRoomId", res.body.id);
}

docs {
  A second room, so the room rule has something to collide with at request 63
  and the maths class has somewhere to move to at request 61.
}
