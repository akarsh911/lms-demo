meta {
  name: Give student maths
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/subject-enrollments
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "student_enrollment_id": "{{enrollmentId}}",
    "subject_offering_id": "{{offeringId}}",
    "enrolled_on": "2026-04-01"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("subjectEnrollmentId", res.body.id);
}

docs {
  Section membership does not imply subject membership. This is what
  says the pupil actually takes Maths.
}
