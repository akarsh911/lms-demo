meta {
  name: Give the second Monday its bells
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/api/v1/calendar-days/{{cancelledDayId}}/schedules
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "period_scheme_id": "{{schemeId}}",
    "bell_schedule_id": "{{bellScheduleId}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("cancelledDayScheduleId", res.body.id);
}

docs {
  Needed for the cancellation to be visible as a cancellation. With no
  schedule on 9 November the class would not be found at all and folder 13
  would get attendance_not_scheduled where it expects
  attendance_class_cancelled.
}
