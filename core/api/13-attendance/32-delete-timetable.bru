meta {
  name: Delete the timetable
  type: http
  seq: 32
}

delete {
  url: {{baseUrl}}/api/v1/timetables/{{timetableId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 204
}

docs {
  204 even with slots still under it - they are cascaded, not refused. The
  four before this delete them one at a time only so the slot delete route is
  exercised at all; a real teardown could stop here.
}
