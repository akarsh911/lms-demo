meta {
  name: Add an extra class
  type: http
  seq: 68
}

post {
  url: {{baseUrl}}/api/v1/timetable-deviations
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "deviation_date": "2026-11-04",
    "kind": "added",
    "section_id": "{{sectionId}}",
    "period_id": "{{periodTwoId}}",
    "subject_offering_id": "{{offeringId}}",
    "start_minute": 590,
    "end_minute": 630,
    "reason": "Extra revision before the unit test."
  }
}

assert {
  res.status: eq 201
  res.body.kind: eq added
  res.body.timetable_slot_id: isUndefined
}

script:post-response {
  bru.setEnvVar("addedDeviationId", res.body.id);
}

docs {
  An added class is the one kind with no slot behind it, so it names its own
  section, period and offering, and it is the one kind that survives its
  timetable being deleted - the other four are cascaded away with the slot
  they hang off.

  start_minute and end_minute are optional here and override the bell for this
  one occurrence. Given together or not at all.

  It appears on 4 November only because that day has a calendar day schedule
  whose period scheme owns period 2. An added class in a period from another
  scheme resolves to nothing at all, silently.
}
