meta {
  name: The Monday's schedules
  type: http
  seq: 40
}

get {
  url: {{baseUrl}}/api/v1/calendar-days/{{calendarDayId}}/schedules
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 1
  res.body.calendar_day_schedules: isArray
}
