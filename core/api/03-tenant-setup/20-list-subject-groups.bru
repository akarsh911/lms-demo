meta {
  name: List subject groups
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/v1/subject-groups?active=true
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.subject_groups[0].status: eq active
  res.body.page.limit: eq 50
  res.body.page.offset: eq 0
}
