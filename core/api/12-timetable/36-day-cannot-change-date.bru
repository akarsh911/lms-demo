meta {
  name: A day cannot change date
  type: http
  seq: 36
}

patch {
  url: {{baseUrl}}/api/v1/calendar-days/{{calendarDayId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "calendar_date": "2026-11-05"
  }
}

assert {
  res.status: eq 422
}

docs {
  Together with academic_session_id and branch_id. The row is identified by
  branch and date; moving the date would either collide with another day or
  carry that day's schedules and attendance somewhere they were never taken.
}
