meta {
  name: Create subject group
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/subject-groups
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "Second Language",
    "description": "Choose exactly one"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("subjectGroupId", res.body.id);
}
