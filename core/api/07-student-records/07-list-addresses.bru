meta {
  name: List addresses
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/student-addresses?student_id={{studentId}}&address_type=home
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 1
  res.body.student_addresses[0].is_primary: eq true
  res.body.student_addresses[0].address_json.city: eq Nagpur
  res.body.page.limit: eq 50
  res.body.page.has_more: eq false
}

docs {
  Addresses are reached through the pupil, never on their own: the query is
  "addresses of students this caller may see", and student_id then narrows
  within that. There is no way to ask for an address without going through a
  student the caller already holds.

  A guardian reaches this on the plain link alone. Documents do not -- see
  07/08, which is gated one step further.
}
