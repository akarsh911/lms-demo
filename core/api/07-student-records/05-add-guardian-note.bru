meta {
  name: Add guardian note
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/student-notes
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "student_id": "{{studentId}}",
    "academic_session_id": "{{sessionId}}",
    "category": "conduct",
    "title": "Parents evening",
    "body": "Please attend on 12 June.",
    "visibility": "guardian"
  }
}

assert {
  res.status: eq 201
  res.body.visibility: eq guardian
}

script:post-response {
  bru.setEnvVar("guardianNoteId", res.body.id);
}

docs {
  The same note written one visibility higher. guardian means the family may
  read it as well as the staff room; it does not mean only the family.

  Same precondition as 07/04: the author comes from the caller, so this needs
  a token with a person record at the school.
}
