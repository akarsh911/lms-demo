meta {
  name: List student assignments
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/student-assignments?student_id={{studentId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 2
  res.body.page.limit: eq 50
  res.body.page.offset: eq 0
  res.body.page.has_more: eq false
}

docs {
  Both roles this pupil holds: class monitor in 6-A and house captain, which
  belongs to no section at all.

  As with sections and offerings, no academic_session_id means the current
  session only. A pupil who was head boy two years ago does not turn up here
  unless all_sessions=true asks for him.

  school_wide=true narrows this further to the roles with no section, the
  house captaincy alone. Every one of these parameters is ANDed onto the set
  the caller was already entitled to, so none of them can widen it.
}
