meta {
  name: The half day closes at lunch
  type: http
  seq: 46
}

get {
  url: {{baseUrl}}/api/v1/timetable-calendar/in-session?branch_id={{branchId}}&date=2026-11-04&half=afternoon
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.in_session: eq false
  res.body.half: eq afternoon
}

docs {
  The same date with half=forenoon answers true. This is the check the
  attendance day route makes per half before it will record anything.
}
