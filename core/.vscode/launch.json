{
  "version": "0.2.0",
  "configurations": [
    {
      // The usual one. F5 starts the API on :8081 with breakpoints live.
      //
      // envFile reads .env, so the debugger gets the same configuration the
      // shell does -- no second copy to drift. Real environment variables
      // still win, as they do everywhere else.
      "name": "API server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/api",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      // Same, with real CAS token verification instead of the development
      // subject. Needs ./scripts/cas-tunnel.sh running in another terminal,
      // and denies everything until this service has CAS client credentials.
      "name": "API server (CAS auth on)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/api",
      "envFile": "${workspaceFolder}/.env",
      "env": { "AUTH_DISABLED": "false" },
      "console": "integratedTerminal"
    },
    {
      // Full request tracing: every step of tenancy, CAS, authz, data and
      // field projection, one line each. This is usually faster than a
      // breakpoint for "why did this return nothing".
      "name": "API server (trace logging)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/api",
      "envFile": "${workspaceFolder}/.env",
      "env": { "LOG_LEVEL": "debug" },
      "console": "integratedTerminal"
    },
    {
      "name": "migrate: status",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/migrate",
      "envFile": "${workspaceFolder}/.env",
      "args": ["status"],
      "console": "integratedTerminal"
    },
    {
      "name": "migrate: apply",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/migrate",
      "envFile": "${workspaceFolder}/.env",
      "args": ["apply"],
      "console": "integratedTerminal"
    },
    {
      // Prompts for the migration name. Replays every migration against
      // DEV_DATABASE_URL and diffs, so that database gets wiped.
      "name": "migrate: make",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/migrate",
      "envFile": "${workspaceFolder}/.env",
      "args": ["make", "${input:migrationName}"],
      "console": "integratedTerminal"
    },
    {
      "name": "seed",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/seed",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      // Debugs the test file open in the editor. Put the cursor in a test and
      // use the "debug test" codelens above it to run just that one.
      "name": "Debug package of current file",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      // For attaching to a server started outside VS Code -- say one already
      // serving an e2e run you want to break into mid-flight.
      "name": "Attach to running api",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickProcess}"
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Migration name, snake_case (e.g. add_student_notes_index)"
    }
  ]
}
