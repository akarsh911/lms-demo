meta {
  name: Move period 2 five minutes later
  type: http
  seq: 26
}

patch {
  url: {{baseUrl}}/api/v1/bell-schedule-periods/{{bellPeriodTwoId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "start_minute": 590,
    "end_minute": 630
  }
}

assert {
  res.status: eq 200
  res.body.start_minute: eq 590
  res.body.end_minute: eq 630
}

docs {
  Both minutes are required on the update even if only one is moving: the
  handler sets the pair unconditionally, so a body with start_minute alone is
  refused 400 rather than leaving end_minute where it was.
}
