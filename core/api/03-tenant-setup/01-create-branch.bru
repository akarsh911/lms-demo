meta {
  name: Create branch
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/branches
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "Main Campus",
    "code": "MAIN",
    "phone": "+91-712-0000000",
    "address_json": {
      "line1": "Ring Road",
      "city": "Nagpur",
      "state": "Maharashtra",
      "postal_code": "440001",
      "country": "IN"
    }
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("branchId", res.body.id);
}

docs {
  First request that needs X-School-Id. Everything below is tenant data.
}
