meta {
  name: Move maths to the laboratory
  type: http
  seq: 61
}

patch {
  url: {{baseUrl}}/api/v1/timetable-slots/{{slotId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "room_id": "{{labRoomId}}"
  }
}

assert {
  res.status: eq 200
  res.body.room_id: eq {{labRoomId}}
}

docs {
  An update is clash-checked exactly as a create is, against the slot as it
  would be after the change rather than as it is now. Moving maths into the
  laboratory is accepted because the laboratory is only busy in period 2; try
  it with a room that is taken in period 1 and the answer is the same 409.
}
