meta {
  name: Create the bell schedule
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/period-schemes/{{schemeId}}/bell-schedules
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "Winter bells",
    "code": "WINTER",
    "is_default": true
  }
}

assert {
  res.status: eq 201
  res.body.code: eq WINTER
  res.body.is_default: eq true
  res.body.period_scheme_id: eq {{schemeId}}
}

script:post-response {
  bru.setEnvVar("bellScheduleId", res.body.id);
}

docs {
  is_default marks the bells a day falls back to. It is not enforced to be
  unique per scheme, so two defaults is a data problem the API will not stop
  you making; the calendar day schedule at request 37 names the bells
  explicitly and that naming is what actually decides the day.
}
