meta {
  name: Add a chapter to the wrong unit
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/v1/curricula/{{curriculumId}}/nodes
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "kind": "chapter",
    "title": "Data handling",
    "sequence": 9,
    "parent_id": "{{curriculumUnitId}}"
  }
}

assert {
  res.status: eq 201
  res.body.kind: eq chapter
}

script:post-response {
  bru.setEnvVar("mistakenNodeId", res.body.id);
}

docs {
  Data handling is not part of the number system. Somebody typing up a syllabus
  puts a chapter under the wrong unit regularly, and the next request is what
  they do about it.
}
