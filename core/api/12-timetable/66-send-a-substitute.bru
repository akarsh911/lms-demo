meta {
  name: Send a substitute
  type: http
  seq: 66
}

post {
  url: {{baseUrl}}/api/v1/timetable-deviations
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "timetable_slot_id": "{{electiveSlotId}}",
    "deviation_date": "2026-11-02",
    "kind": "substitution",
    "substitute_teacher_id": "{{teacherId}}",
    "reason": "French has nobody assigned to it yet; cover arranged for the day."
  }
}

assert {
  res.status: eq 201
  res.body.kind: eq substitution
  res.body.substitute_teacher_id: eq {{teacherId}}
}

script:post-response {
  bru.setEnvVar("substitutionId", res.body.id);
}

docs {
  The substitute is recorded against the day, not written onto the slot, so
  next Monday the regular teacher is back without anyone having to undo
  anything. The occurrence feed reports the substitute as the teacher for that
  date and marks the state accordingly.

  A substitution is not clash-checked against the substitute's own timetable.
  A deputy head covering two rooms at once is a real possibility this API will
  not stop you recording.
}
