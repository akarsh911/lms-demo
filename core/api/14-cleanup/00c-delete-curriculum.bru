meta {
  name: Delete curriculum
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/curricula/{{curriculumId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 204
}

docs {
  Cascades to its nodes. Folder 11 removes both placements before this runs -
  a curriculum node with a placement on it refuses to be deleted, so the order
  is load bearing rather than tidy.
}
