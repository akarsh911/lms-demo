meta {
  name: Is the Monday in session
  type: http
  seq: 44
}

get {
  url: {{baseUrl}}/api/v1/timetable-calendar/in-session?branch_id={{branchId}}&date=2026-11-02
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.in_session: eq true
  res.body.date: eq 2026-11-02
}
