meta {
  name: List rooms
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/rooms?branch_id={{branchId}}&status=active
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: gte 2
  res.body.rooms: isArray
}

docs {
  Rooms belong to a branch, not to a session, so this list does not narrow by
  academic session and a room outlives the year it was timetabled in.
}
