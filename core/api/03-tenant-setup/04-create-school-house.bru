meta {
  name: Create school house
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/school-houses
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "Emerald",
    "code": "EMR",
    "display_config_json": {
      "colour": "#0F8B5C",
      "sort_order": 1
    }
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("houseId", res.body.id);
}
