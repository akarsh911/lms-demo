meta {
  name: The cancelled Monday
  type: http
  seq: 77
}

get {
  url: {{baseUrl}}/api/v1/timetable-occurrences?branch_id={{branchId}}&date=2026-11-09
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 4
}

docs {
  Four occurrences, one of them cancelled. The cancelled class is reported
  rather than omitted because "this class is not happening" is information a
  pupil's day needs to show.
}
