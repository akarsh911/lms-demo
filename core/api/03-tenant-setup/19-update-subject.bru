meta {
  name: Update subject
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/api/v1/subjects/{{subjectId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "short_name": "Math",
    "description": "Number, algebra, geometry and data handling."
  }
}

assert {
  res.status: eq 200
  res.body.short_name: eq Math
  res.body.code: eq MATH
  res.body.subject_type: eq academic
}

docs {
  short_name is what fits on a report card; name is what goes in a prospectus.
  is_elective is left alone: flipping it would not move anyone's subject
  enrolments, so a subject that pupils are already sitting must not become an
  elective by an edit here.
}
