# Emerge front end — copy to .env.local

# The Emerge app's own origin. Runs on :3005 by convention.
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# CAS base URL. This is called SERVER-TO-SERVER from the BFF only; the browser
# never talks to CAS directly, which is why no CORS entry is required for it.
CAS_BASE_URL=http://localhost:8080

# Secret used to seal the session cookie (AES-256-GCM via `jose`).
# 32+ bytes. Generate with: openssl rand -base64 32
# This is a SERVER-side secret. It is never sent to the browser, which is the
# entire difference between this and the rejected "key in frontend constants".
SESSION_SECRET=replace-me-with-32-bytes-of-random

# --- Single sign-on through CAS's hosted pages ------------------------------
# Off by default: the sign-in page keeps its own password form. On (true or 1),
# /sign-in redirects to CAS /oauth/authorize (authorization code + PKCE S256)
# and CAS's page handles password, Google and the second factor. Ignored under
# the dev bypass.
# CAS_SSO_ENABLED=true
#
# redirect (default) sends the whole tab to CAS; popup opens CAS in a small
# window and the sign-in page waits for it.
# CAS_SSO_MODE=redirect
#
# Provider buttons on the popup sign-in page. Each sends provider=<name> so CAS
# goes straight to that provider. Empty hides them; unset means google.
# CAS_SSO_PROVIDERS=google
#
# The OAuth client registered in CAS for this app. Confidential: the secret is
# read server-side only and never reaches the browser. When set, password and
# passwordless sign-in also send it as client_id so CAS applies this app's
# per-tenant method policy, even with SSO off.
# CAS_CLIENT_ID=emerge-web
# CAS_CLIENT_SECRET=
#
# This app's public origin. CAS must have ${APP_URL}/auth/callback in the
# client's redirect_uris and ${APP_URL}/ in post_logout_redirect_uris.
# Defaults to NEXT_PUBLIC_SITE_URL.
# APP_URL=http://localhost:3005

# --- Dev bypass -------------------------------------------------------------
# The one switch. No CAS and no backend calls: nobody signs in, and every
# function in src/services answers from src/fixtures instead of calling the API.
# Restart the dev server after changing it.
#
# It is honoured in EVERY build, so a deployed host with DEV_BYPASS=1 serves
# fixtures with sign-in off for everyone who reaches it. Unset or 0 means the
# real services. Rebuild a deployment after changing it.
# DEV_BYPASS=1
#
# Optional. Which fixture user everything is served as; nobody signs in.
# `admin` (default, every screen), `teacher`, `student`, `parent`.
# DEV_BYPASS_USER=teacher
#
# Real mode only: save each relayed JSON response to the gitignored
# .fixtures-raw/ so the fixtures can be compared with the live backend.
# RECORD_FIXTURES=1
#
# The tenant sent as X-School-Id with any call the bypass forwards live:
# DEV_LIVE_SERVICES below, and the public demo's retrieval.
# DEV_SCHOOL_ID=S_42
#
# Bypass only: these services go to their real backend (their *_API_URL must be
# set), everything else stays on fixtures. Restart the dev server after changing.
# DEV_LIVE_SERVICES=papersetter
#
# Server-only bearer for a listed service that needs one. DEV_<SERVICE>_TOKEN
# wins over DEV_SERVICE_TOKEN. For the paper setter run behind
# scripts/dev-papersetter.py, take it from `--print-token`.
# DEV_PAPERSETTER_TOKEN=
# DEV_SERVICE_TOKEN=
#
# On by default under the bypass: a listed call that cannot connect or answers
# 5xx is answered by its fixture, with a console warning. 0 shows the failure.
# DEV_LIVE_FALLBACK=0

# --- emerge-core ------------------------------------------------------------
# The school's own record: people, academic structure, library, curriculum.
#
# INCLUDE THE VERSION PREFIX. Every route is under /api/v1, so it is carried
# here rather than repeated in every path in src/services/core.ts.
CORE_API_URL=http://localhost:8081/api/v1

# WHICH SCHOOL THIS DEPLOYMENT SERVES. Its code (DPS-NGP) or its school_id UUID,
# as the control plane knows it.
#
# There is no default and there must not be one. emerge-core is
# database-per-tenant: X-School-Id selects the DATABASE a request runs against,
# so a guessed value is not a wrong filter, it is the wrong school's records. It
# is read server-side only and is never sent to the browser; the proxy strips
# any x-school-id a client sets and states this one instead, after emerge-core
# has confirmed it against the session's own token. See src/server/core/tenant.ts.
#
# The CAS tenant slug in the access token is NOT this value: emerge-core
# resolves the header as a UUID or a school code and never as a CAS slug.
CORE_SCHOOL_ID=DPS-NGP

# --- paper-setter -----------------------------------------------------------
# Question papers, behind the sidebar section of the same name.
#
# No fallback, for the same reason as emerge-core above: an unset variable is a
# 503 that NAMES it, rather than a guessed host. Left empty here because each
# environment names its own host; in production the service answers on the
# shared docker network as http://papersetter:8000.
PAPERSETTER_API_URL=
