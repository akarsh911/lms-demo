meta {
  name: Create student assignment
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/student-assignments
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "student_id": "{{studentId}}",
    "section_id": "{{sectionId}}",
    "role_type": "class_monitor",
    "is_primary": true,
    "valid_from": "2026-04-01"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("studentAssignmentId", res.body.id);
}
