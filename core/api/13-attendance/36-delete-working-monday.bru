meta {
  name: Delete the working Monday
  type: http
  seq: 36
}

delete {
  url: {{baseUrl}}/api/v1/calendar-days/{{calendarDayId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 204
}

docs {
  A calendar day with schedules still attached deletes too - they cascade. The
  three before this exist to exercise the day schedule delete route, not
  because the order is forced.
}
