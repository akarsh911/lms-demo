meta {
  name: Explain the cancellation
  type: http
  seq: 73
}

patch {
  url: {{baseUrl}}/api/v1/timetable-deviations/{{cancelledDeviationId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "reason": "Teacher on examination duty; the class will be made up on 16 November."
  }
}

assert {
  res.status: eq 200
  res.body.kind: eq cancelled
}

docs {
  The reason is the part that gets edited in practice, because the reason is
  what a parent is told. Sending null clears it; so do room_id,
  substitute_teacher_id, start_minute and end_minute, which is how a room
  change is undone without deleting the record that it happened.
}
