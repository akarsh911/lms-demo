meta {
  name: Students taking french
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/subject-enrollments?subject_offering_id={{electiveOfferingId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 1
}

docs {
  What a French subject teacher may see, as opposed to the whole section.
}
