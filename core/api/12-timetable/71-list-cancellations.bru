meta {
  name: November's cancellations
  type: http
  seq: 71
}

get {
  url: {{baseUrl}}/api/v1/timetable-deviations?from=2026-11-01&to=2026-11-30&kind=cancelled
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 1
  res.body.timetable_deviations: isArray
}

docs {
  Also narrows by timetable_slot_id, section_id, period_id,
  subject_offering_id, substitute_teacher_id and room_id. Filtering by
  substitute_teacher_id is how a cover roster is built for a week.
}
