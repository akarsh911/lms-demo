meta {
  name: Create person for teacher
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/persons
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "cas_user_id": "22222222-2222-4222-8222-222222222222",
    "first_name": "Meera",
    "last_name": "Iyer",
    "display_name": "Meera Iyer",
    "email": "meera@example.com"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("teacherPersonId", res.body.id);
}
