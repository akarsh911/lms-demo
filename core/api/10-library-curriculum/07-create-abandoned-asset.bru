meta {
  name: Create an asset that is never uploaded
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/library/assets
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "file_name": "wrong-scan.pdf",
    "mime_type": "application/pdf",
    "size_bytes": 12044,
    "sha256": "dcce5350b6a8a2157b7d883f4987f1a21483ca3c7ba1e02cc16bdab868dbd7c2",
    "metadata_json": {
      "note": "scanned the wrong book"
    }
  }
}

assert {
  res.status: eq 201
  res.body.status: eq pending
}

script:post-response {
  bru.setEnvVar("abandonedAssetId", res.body.id);
}

docs {
  A second asset, made only so the next request can delete one. Deleting the
  asset the textbook hangs off would change what folder 11 resolves, which is
  a real behaviour worth seeing but not while it is standing in for a delete.
}
