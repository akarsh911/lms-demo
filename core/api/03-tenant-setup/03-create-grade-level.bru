meta {
  name: Create grade level
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/grade-levels
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "Class 6",
    "code": "G6",
    "sequence": 6,
    "education_stage": "middle"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("gradeLevelId", res.body.id);
}
