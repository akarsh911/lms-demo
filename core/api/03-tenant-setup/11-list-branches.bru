meta {
  name: List branches
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/branches?active=true
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.branches[0].status: eq active
  res.body.page.limit: eq 50
  res.body.page.offset: eq 0
  res.body.page.has_more: eq false
}

docs {
  Branches are reference data: read, write, delete, and no breadth key. There
  is no ReferenceReadAll, because a branch is not narrowed per person -- every
  caller who may read reference data reads all of it. Do not go looking for an
  *_all entity here; its absence is a decision, not a gap.
}
