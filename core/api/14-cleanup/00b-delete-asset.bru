meta {
  name: Delete asset
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/api/v1/library/assets/{{assetId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 204
}

docs {
  A soft delete - the row is marked deleted and kept as the audit record, and
  the S3 object is not removed by this call. Nothing in this service deletes an
  object; `cmd/assetreap` does, and only with an explicit destructive flag.
}
