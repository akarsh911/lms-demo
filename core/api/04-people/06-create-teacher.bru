meta {
  name: Create teacher
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/teachers
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "staff_id": "{{staffId}}",
    "teacher_code": "TCH-0001",
    "specialization": "Mathematics",
    "qualification_json": [
      {
        "degree": "M.Sc",
        "field": "Mathematics",
        "institution": "Nagpur University",
        "year": 2012
      }
    ]
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("teacherId", res.body.id);
}

docs {
  Teacher is a specialisation of Staff. Most staff are not teachers.
}
