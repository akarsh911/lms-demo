meta {
  name: Delete the rejected placement
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/api/v1/placements/{{wholeBookPlacementId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 204
}

docs {
  Deleting is not how a mapping is turned down -- that is request 10, and the
  rejected row is worth keeping. This is the run cleaning up after itself.

  A placement is the only thing here that deletes freely: nothing else points
  at it, and the curriculum, the node and the content item it named all
  survive it untouched.
}
