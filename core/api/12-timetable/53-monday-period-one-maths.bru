meta {
  name: Monday period 1 is maths
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/api/v1/timetables/{{timetableId}}/slots
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "section_id": "{{sectionId}}",
    "period_id": "{{periodOneId}}",
    "day_of_week": 1,
    "subject_offering_id": "{{offeringId}}",
    "teacher_id": "{{teacherId}}",
    "room_id": "{{roomId}}"
  }
}

assert {
  res.status: eq 201
  res.body.day_of_week: eq 1
  res.body.timetable_id: eq {{timetableId}}
  res.body.subject_offering_id: eq {{offeringId}}
}

script:post-response {
  bru.setEnvVar("slotId", res.body.id);
}

docs {
  day_of_week is ISO: 1 is Monday and 7 is Sunday, so 0 is refused 400 rather
  than read as Sunday. A slot is a weekly pattern, not a date - it becomes
  dates only when the calendar is walked at request 75.

  This is the slot folder 13's register is taken against.
}
