meta {
  name: Record the half day's forenoon
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/attendance/days
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "student_id": "{{studentId}}",
    "section_id": "{{sectionId}}",
    "attendance_date": "2026-11-04",
    "forenoon_status": "present"
  }
}

assert {
  res.status: eq 201
  res.body.forenoon_status: eq present
  res.body.afternoon_status: isUndefined
  res.body.source: eq manual
}

script:post-response {
  bru.setEnvVar("halfDayAttendanceId", res.body.id);
}

docs {
  The same date, the open half only, accepted. The response carries no
  afternoon_status field at all rather than a value meaning "not absent" - the
  afternoon did not happen, and the record says nothing about it instead of
  saying something false about it.
}
