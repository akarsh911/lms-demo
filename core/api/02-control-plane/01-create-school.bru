meta {
  name: Create school
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/schools
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Delhi Public School Nagpur",
    "code": "{{schoolCode}}",
    "legal_name": "DPS Nagpur Education Society",
    "timezone": "Asia/Kolkata",
    "country": "IN",
    "state": "Maharashtra",
    "city": "Nagpur",
    "email": "office@dps-nagpur.example"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("schoolId", res.body.id);
}

docs {
  Control plane. No X-School-Id: this is where a school comes from.
}
