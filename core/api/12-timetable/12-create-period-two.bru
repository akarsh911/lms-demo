meta {
  name: Create period 2
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/period-schemes/{{schemeId}}/periods
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "Period 2",
    "code": "P2",
    "sequence": 2,
    "kind": "teaching"
  }
}

assert {
  res.status: eq 201
  res.body.sequence: eq 2
}

script:post-response {
  bru.setEnvVar("periodTwoId", res.body.id);
}
