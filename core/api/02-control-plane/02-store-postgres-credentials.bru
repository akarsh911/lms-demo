meta {
  name: Store postgres credentials
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/schools/{{schoolId}}/profiles/postgres
  body: json
  auth: inherit
}

body:json {
  {
    "host": "localhost",
    "port": 5434,
    "database": "emerge_tenant_demo",
    "user": "emerge",
    "password": "emerge",
    "sslmode": "disable"
  }
}

assert {
  res.status: eq 200
  res.body.stored: eq true
}

docs {
  Encrypted with AES-256-GCM before it is stored, using the school id
  as additional authenticated data. The plaintext is never persisted and never
  returned. Run `migrate apply -plane tenant` after this, before anything below.
}
