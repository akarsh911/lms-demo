meta {
  name: Get student
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/v1/students/{{studentId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{studentId}}
  res.body.admission_number: eq ADM-2026-0001
  res.body.status: eq active
}

docs {
  The student row, not the person row: name, date of birth and contact details
  live on the person this points at, and are read through /persons.

  No class or section appears here either. Those belong to an enrolment, which
  is scoped to one academic session, and folder 05 creates it. A student who
  has been at the school for four years has four enrolments and one student row.
}
