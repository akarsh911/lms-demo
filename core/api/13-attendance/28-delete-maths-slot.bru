meta {
  name: Delete the maths slot
  type: http
  seq: 28
}

delete {
  url: {{baseUrl}}/api/v1/timetable-slots/{{slotId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 204
}

docs {
  The marks taken against this slot were deleted at request 21, but they did
  not have to be: attendance_period.timetable_slot_id is nulled when the slot
  goes rather than blocking the delete or taking the mark with it. A mark
  outlives the plan that scheduled it, because it is a record of what
  happened and the plan is only a statement of what was meant to.
}
