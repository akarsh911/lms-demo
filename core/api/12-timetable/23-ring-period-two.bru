meta {
  name: Ring period 2
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/bell-schedules/{{bellScheduleId}}/periods
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "period_id": "{{periodTwoId}}",
    "start_minute": 585,
    "end_minute": 625
  }
}

assert {
  res.status: eq 201
  res.body.start_minute: eq 585
}

script:post-response {
  bru.setEnvVar("bellPeriodTwoId", res.body.id);
}

docs {
  Period 2 starts the minute period 1 ends. Adjacency is not a clash: the
  clash rules work on the period a slot sits in, not on overlapping minutes,
  so two bells that touch are simply two periods.
}
