meta {
  name: Note on the day
  type: http
  seq: 35
}

patch {
  url: {{baseUrl}}/api/v1/calendar-days/{{calendarDayId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "notes": "Assembly runs long; period 1 starts five minutes late."
  }
}

assert {
  res.status: eq 200
  res.body.notes: isDefined
  res.body.forenoon_open: eq true
}

docs {
  A note is prose for the people reading the calendar. It changes nothing the
  resolver looks at - a late start is still period 1 at 09:05 as far as every
  register and occurrence is concerned, because the bells are what carry time.
}
