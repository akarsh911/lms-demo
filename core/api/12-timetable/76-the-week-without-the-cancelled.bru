meta {
  name: The week, minus what was cancelled
  type: http
  seq: 76
}

get {
  url: {{baseUrl}}/api/v1/timetable-occurrences?branch_id={{branchId}}&from=2026-11-02&to=2026-11-09&section_id={{sectionId}}&omit_cancelled=true
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 8
  res.body.to: eq 2026-11-09
}

docs {
  Two Mondays and a half day. omit_cancelled drops the cancelled maths class
  on the 9th; without it there is one more and it is present with state
  "cancelled", which is what a register screen wants so it can grey the row
  out rather than lose it.

  section_id, period_id, teacher_id, room_id and subject_offering_id each
  narrow through both the slot and the deviation, so filtering by teacher
  finds the classes they cover as a substitute as well as their own.
}
