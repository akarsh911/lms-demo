meta {
  name: Get asset
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/library/assets/{{assetId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{assetId}}
  res.body.status: eq pending
  res.body.mime_type: eq application/pdf
}

docs {
  Reading an asset never mints a link. The upload URL came back once, from the
  request that created the row; a signed URL handed out on every read is a
  signed URL in every log and every browser history.

  pending means the row exists and the bytes do not. That is the state to
  expect for as long as nobody has uploaded, and it is why status is the
  server's to set: a caller who could write "ready" could claim bytes that were
  never sent.
}
