# Emerge Labs — public demo deployment. Copy to `.env` beside docker-compose.yml.

# Serves every visitor a fixture session with no sign-in. Nothing is persisted
# and there are no real users. Remove this to require a real CAS sign-in.
PUBLIC_DEMO=1

# This app's own public origin, behind the shared nginx.
NEXT_PUBLIC_SITE_URL=https://labs.tryemerge.in

# Retrieval engine (cited NCERT passages), reached through /api/svc/retrieval.
# MUST be https. The service proxy fetches with `redirect: 'manual'` and this
# host 301-redirects http -> https, so an http:// value here hands the browser
# a bodyless 301 instead of data.
RETRIEVAL_API_URL=https://library.tryemerge.in

# Tenant the retrieval engine scopes by while the demo fixture session is used.
DEV_SCHOOL_ID=S_42

# Seals the session cookie (AES-256-GCM). Unused in demo mode, but set it so no
# code path starts without it. 32+ bytes; generate with: openssl rand -base64 32
SESSION_SECRET=

# CAS origin, called server-to-server only. Unused in demo mode; set so no stray
# code path throws on a missing value.
CAS_BASE_URL=https://auth.tryemerge.in

# Single sign-on through CAS. Unused in demo mode, where the bypass turns it off.
# On a real deployment: CAS_SSO_ENABLED=true, the client id and secret CAS
# issued, and APP_URL as the origin registered in the client's redirect URIs.
#CAS_SSO_ENABLED=
#CAS_SSO_MODE=redirect
#CAS_SSO_PROVIDERS=google
#CAS_CLIENT_ID=emerge-web
#CAS_CLIENT_SECRET=
#APP_URL=https://lms.tryemerge.in

# Number of proxy hops to trust when deriving the client IP. This app sits
# behind exactly one shared nginx.
TRUSTED_PROXY_HOPS=1

# No backend exists for these yet — in demo mode they are answered from
# in-process fixtures, so leave them unset. Set one only when its service is
# actually deployed.
#ATTENDANCE_API_URL=
#TIMETABLE_API_URL=
#ACADEMICS_API_URL=
#LABS_API_URL=

# The flashcard engine. It is deployed elsewhere, but is not reachable in real
# mode yet: it requires `X-School-Id` and refuses a default, and this app states
# that header only while bypassing. In demo mode every one of its paths is
# answered from src/fixtures/flashcards.ts and nothing falls through, so a
# URL here has no effect until that changes.
#FLASHCARDS_API_URL=
