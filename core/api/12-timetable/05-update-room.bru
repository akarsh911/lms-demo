meta {
  name: Correct the room
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/rooms/{{roomId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "capacity": 42,
    "floor": "Ground"
  }
}

assert {
  res.status: eq 200
  res.body.capacity: eq 42
  res.body.floor: eq Ground
}

docs {
  building, floor and capacity clear when sent as null; name and code do not,
  because a room with no name is not a room. Sending "capacity": null removes
  the number rather than setting it to zero, which matters because zero would
  make the room look full rather than unmeasured.
}
