meta {
  name: Teacher role on a student
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/student-assignments
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "student_id": "{{studentId}}",
    "section_id": "{{sectionId}}",
    "role_type": "class_teacher"
  }
}

assert {
  res.status: eq 400
}

docs {
  student_assignments and teacher_assignments have identical shapes, which
  makes putting a teacher role on a student easy and silent. It is refused,
  with a message pointing at /api/v1/teacher-assignments.
}
