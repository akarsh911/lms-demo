meta {
  name: List academic sessions
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/academic-sessions?current=true
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 1
  res.body.academic_sessions[0].is_current: eq true
  res.body.page.limit: eq 50
  res.body.page.offset: eq 0
  res.body.page.has_more: eq false
}

docs {
  Every listing carries a page object: the window that was asked for and
  whether there is more behind it. has_more is derived from whether the page
  came back full, not from a second counting query, so a page that is exactly
  full reports has_more true and the next page comes back empty. Cheap, and
  honest about what it knows.

  current=true is the narrowing that makes count exactly 1: only one session
  may be current at a time, which 03/02 enforced by demoting the others.
}
