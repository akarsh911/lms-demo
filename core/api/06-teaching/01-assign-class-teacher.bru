meta {
  name: Assign class teacher
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/teacher-assignments
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "teacher_id": "{{teacherId}}",
    "section_id": "{{sectionId}}",
    "role_type": "class_teacher",
    "is_primary": true,
    "valid_from": "2026-04-01"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("classTeacherAssignmentId", res.body.id);
}

docs {
  No subject_offering_id, so this covers the whole section. The class
  teacher sees every pupil in it, whatever subjects they take.
}
