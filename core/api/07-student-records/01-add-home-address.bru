meta {
  name: Add home address
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/student-addresses
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "student_id": "{{studentId}}",
    "address_type": "home",
    "is_primary": true,
    "valid_from": "2026-04-01",
    "address_json": {
      "line1": "42 Civil Lines",
      "city": "Nagpur",
      "state": "Maharashtra",
      "postal_code": "440001",
      "country": "IN"
    }
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("addressId", res.body.id);
}
