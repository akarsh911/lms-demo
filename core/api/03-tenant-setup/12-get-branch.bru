meta {
  name: Get branch
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/branches/{{branchId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{branchId}}
  res.body.code: eq MAIN
  res.body.address_json.city: eq Nagpur
}

docs {
  address_json is stored as a document, not as columns, so it comes back
  exactly as it was posted. Nothing normalises it.
}
