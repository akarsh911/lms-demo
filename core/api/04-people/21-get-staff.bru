meta {
  name: Get staff member
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/v1/staff/{{staffId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{staffId}}
  res.body.employee_code: eq EMP-0001
  res.body.designation: eq Senior Teacher
  res.body.person_id: eq {{teacherPersonId}}
}

docs {
  person_id points back at the person created in request 04. Employment lives
  here, identity lives there: someone who leaves and is rehired keeps one person
  row and gains a second staff row.

  Salary and bank details are deliberately not on this row and not on this
  route. They belong to a payroll surface with its own capability, so that
  core.staff.read - which every teacher needs to see a colleague's designation -
  does not quietly carry them.
}
