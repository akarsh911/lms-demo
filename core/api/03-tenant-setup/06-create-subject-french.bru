meta {
  name: Create subject french
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/subjects
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "French",
    "short_name": "Fre",
    "code": "FRE",
    "subject_type": "language",
    "is_elective": true
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("electiveSubjectId", res.body.id);
}

docs {
  An elective. Not every pupil in a section takes it, which is the whole point of subject enrolments.
}
