meta {
  name: Create french offering
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/subject-offerings
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "section_id": "{{sectionId}}",
    "subject_id": "{{electiveSubjectId}}",
    "subject_group_id": "{{subjectGroupId}}",
    "periods_per_week": 3,
    "maximum_marks": 100,
    "pass_marks": 33
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("electiveOfferingId", res.body.id);
}
