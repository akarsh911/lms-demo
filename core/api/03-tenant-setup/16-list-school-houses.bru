meta {
  name: List school houses
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/v1/school-houses?active=true
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.school_houses[0].status: eq active
  res.body.page.limit: eq 50
  res.body.page.offset: eq 0
}

docs {
  There is no GET /school-houses/{id}. Houses, grade levels, subjects and
  subject groups are read as a set and written one at a time: a school has a
  handful of each and a client that wants one of them already has the list.
}
