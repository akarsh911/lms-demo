meta {
  name: Status is a closed list
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/attendance/register
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "subject_offering_id": "{{offeringId}}",
    "period_id": "{{periodOneId}}",
    "attendance_date": "2026-11-02",
    "entries": [
      {
        "student_id": "{{studentId}}",
        "status": "here"
      }
    ]
  }
}

assert {
  res.status: eq 400
}

docs {
  present, absent, late or excused, and nothing else. "excused" is the one
  that earns its place: an absence the school has accepted is not the same
  number as an absence it has not, and a school that cannot say so ends up
  keeping that distinction in the remarks where nothing can count it.
}
