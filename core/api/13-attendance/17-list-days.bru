meta {
  name: November, day by day
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/attendance/days?student_id={{studentId}}&from=2026-11-01&to=2026-11-30
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 2
  res.body.attendance_days: isArray
}

docs {
  Narrows by student_id, section_id, academic_session_id and a date window.
  section_id over a window is the query the daily roll is built from; there is
  no route that returns a whole section's day at once, so a roll is this list
  filtered by section and date.
}
