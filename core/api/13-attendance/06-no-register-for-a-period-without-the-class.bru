meta {
  name: No register for a period the class does not have
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/attendance/register
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "subject_offering_id": "{{offeringId}}",
    "period_id": "{{periodTwoId}}",
    "attendance_date": "2026-11-02",
    "entries": [
      {
        "student_id": "{{studentId}}",
        "status": "present"
      }
    ]
  }
}

assert {
  res.status: eq 422
  res.body.message: contains attendance_not_scheduled
}

docs {
  Maths is timetabled in period 1, not period 2, so there is no occurrence to
  hang the mark on. This is by far the most common cause of a surprise 422 in
  practice, and it has three quite different origins that look identical: the
  class genuinely is not in that period, or the slot's day_of_week does not
  match the weekday of the date, or - the one that catches people - the
  calendar day exists and is open but has no calendar_day_schedules row, so
  the resolver finds no classes at all that day. Check folder 12 request 37
  before assuming the timetable is wrong.
}
