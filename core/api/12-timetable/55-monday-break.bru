meta {
  name: Monday's break
  type: http
  seq: 55
}

post {
  url: {{baseUrl}}/api/v1/timetables/{{timetableId}}/slots
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "section_id": "{{sectionId}}",
    "period_id": "{{breakPeriodId}}",
    "day_of_week": 1,
    "label": "Short break"
  }
}

assert {
  res.status: eq 201
  res.body.label: eq Short break
  res.body.subject_offering_id: isUndefined
}

script:post-response {
  bru.setEnvVar("breakSlotId", res.body.id);
}

docs {
  A slot needs either a subject offering or a label. The label is what lets
  non-teaching time be timetabled without inventing a fake subject for
  assembly, games and the break - and because there is no offering, nobody can
  mark a register against it.
}
