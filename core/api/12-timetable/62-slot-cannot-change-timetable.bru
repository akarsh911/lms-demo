meta {
  name: A slot cannot change timetable
  type: http
  seq: 62
}

patch {
  url: {{baseUrl}}/api/v1/timetable-slots/{{slotId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "timetable_id": "{{timetableId}}"
  }
}

assert {
  res.status: eq 422
}

docs {
  422 here rather than the 400 of request 17, because timetable_id does exist
  in the slot shape and so reaches the handler's own immutability check.
  Moving a slot between timetables would move it out of the window it was
  clash-checked in.
}
