meta {
  name: A span must lie inside the day
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/v1/bell-schedules/{{bellScheduleId}}/periods
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "period_id": "{{breakPeriodId}}",
    "start_minute": 700,
    "end_minute": 690
  }
}

assert {
  res.status: eq 422
}

docs {
  Inverted here, but the same refusal covers a negative start and an end past
  1440. There is no wrap-around: a period cannot run past midnight, which is
  why a boarding school's night prep is a separate day's calendar entry rather
  than minute 1500.
}
