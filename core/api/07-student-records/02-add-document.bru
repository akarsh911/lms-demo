meta {
  name: Add document
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/student-documents
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "student_id": "{{studentId}}",
    "document_type": "birth_certificate",
    "asset_id": "44444444-4444-4444-8444-444444444444",
    "document_number": "BC-99213",
    "issued_by": "Nagpur Municipal Corporation",
    "issued_at": "2014-08-01"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("documentId", res.body.id);
}

docs {
  asset_id points at the assets table, which does not exist yet, so it
  is an unenforced reference for now. Any UUID is accepted.
}
