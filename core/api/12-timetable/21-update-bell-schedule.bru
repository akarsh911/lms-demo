meta {
  name: Rename the bell schedule
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/api/v1/bell-schedules/{{bellScheduleId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "Winter bells (from November)"
  }
}

assert {
  res.status: eq 200
  res.body.code: eq WINTER
}
