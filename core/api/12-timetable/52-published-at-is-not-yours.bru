meta {
  name: published_at is not yours to send
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/api/v1/timetables
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "period_scheme_id": "{{schemeId}}",
    "name": "Back-dated timetable",
    "effective_from": "2026-04-01",
    "published_at": "2026-04-01T00:00:00Z"
  }
}

assert {
  res.status: eq 422
}

docs {
  A publication date that could be supplied is a publication date that can be
  back-dated, and the whole value of the field is that it records when the
  school actually committed to the week. No row is written.
}
