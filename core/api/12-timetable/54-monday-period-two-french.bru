meta {
  name: Monday period 2 is French
  type: http
  seq: 54
}

post {
  url: {{baseUrl}}/api/v1/timetables/{{timetableId}}/slots
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "section_id": "{{sectionId}}",
    "period_id": "{{periodTwoId}}",
    "day_of_week": 1,
    "subject_offering_id": "{{electiveOfferingId}}",
    "room_id": "{{labRoomId}}"
  }
}

assert {
  res.status: eq 201
  res.body.subject_offering_id: eq {{electiveOfferingId}}
  res.body.teacher_id: isUndefined
}

script:post-response {
  bru.setEnvVar("electiveSlotId", res.body.id);
}

docs {
  No teacher. teacher_id is optional on a slot, and a class with nobody
  against it still resolves into the week, still clashes on room, and still
  takes a register - which is what lets a school publish the shape of the year
  in June and fill in who teaches what in July. The substitution at request 66
  is recorded against this slot for exactly that reason.
}
