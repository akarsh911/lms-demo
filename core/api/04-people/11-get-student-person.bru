meta {
  name: Get person
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/persons/{{studentPersonId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{studentPersonId}}
  res.body.display_name: eq Aarav Sharma
}

docs {
  The single-row read is projected through the same field policy as the list,
  so a caller whose policy covers fewer columns gets fewer keys back. A key
  that is missing means "not permitted to see", not "empty".

  So read an absent key as a statement about your policy, not about the row.
  Which is exactly why a field that is absent for any other reason is a bug
  worth chasing rather than a quirk worth documenting.
}
