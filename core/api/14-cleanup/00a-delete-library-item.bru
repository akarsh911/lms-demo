meta {
  name: Delete library item
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/api/v1/library/{{libraryItemId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 204
}

docs {
  The content item goes before its owner person and before the subject and
  grade level it points at. A library item holds foreign keys into all three.
}
