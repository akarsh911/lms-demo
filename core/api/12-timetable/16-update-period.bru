meta {
  name: Rename period 1
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/api/v1/periods/{{periodOneId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "First period"
  }
}

assert {
  res.status: eq 200
  res.body.name: eq First period
  res.body.code: eq P1
}

docs {
  The code is what the rest of the system reads; the name is what the
  timetable prints. Renaming one does not touch the other.
}
