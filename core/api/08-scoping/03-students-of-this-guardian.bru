meta {
  name: Students of this guardian
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/students?guardian_id={{guardianId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: eq 1
}

docs {
  An explicit filter. The implicit version is what a guardian's own
  token gets: CAS grants core.students.read, emerge-core narrows to their children.
}
