meta {
  name: No register for a cancelled class
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/attendance/register
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "subject_offering_id": "{{offeringId}}",
    "period_id": "{{periodOneId}}",
    "attendance_date": "2026-11-09",
    "entries": [
      {
        "student_id": "{{studentId}}",
        "status": "present"
      }
    ]
  }
}

assert {
  res.status: eq 422
  res.body.message: contains attendance_class_cancelled
}

docs {
  A distinct refusal from "not scheduled", and the distinction is the whole
  reason deviations are rows rather than deletions: the class was timetabled,
  somebody cancelled it, and nobody should be marked absent from a lesson that
  was called off. Reverse the cancellation - delete the deviation - and the
  same register is accepted.

  A pupil who came in on 9 November and found no maths is recorded through the
  day mark, not this one.
}
