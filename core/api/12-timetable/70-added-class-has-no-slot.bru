meta {
  name: An added class has no slot
  type: http
  seq: 70
}

post {
  url: {{baseUrl}}/api/v1/timetable-deviations
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "deviation_date": "2026-11-16",
    "kind": "added",
    "timetable_slot_id": "{{slotId}}",
    "section_id": "{{sectionId}}",
    "period_id": "{{periodTwoId}}",
    "subject_offering_id": "{{offeringId}}"
  }
}

assert {
  res.status: eq 422
}

docs {
  An added class is not a change to a planned one, so it cannot name a planned
  one. The same wall stands on update: a deviation cannot be switched between
  added and the other four kinds, only deleted and re-recorded.
}
