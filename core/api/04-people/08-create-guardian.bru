meta {
  name: Create guardian
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/guardians
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "person_id": "{{guardianPersonId}}",
    "occupation": "Engineer",
    "employer": "Tata Motors"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("guardianId", res.body.id);
}
