meta {
  name: Duplicate admission number
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/students
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "person_id": "{{studentPersonId}}",
    "admission_number": "ADM-2026-0001"
  }
}

assert {
  res.status: eq 409
}

docs {
  admission_number is unique. A second one conflicts rather than overwriting.
}
