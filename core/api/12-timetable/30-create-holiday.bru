meta {
  name: Create the holiday
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/api/v1/calendar-days
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "branch_id": "{{branchId}}",
    "calendar_date": "2026-11-03",
    "day_type": "holiday",
    "forenoon_open": false,
    "afternoon_open": false,
    "name": "Founder's Day"
  }
}

assert {
  res.status: eq 201
  res.body.forenoon_open: eq false
}

script:post-response {
  bru.setEnvVar("holidayDayId", res.body.id);
}

docs {
  A holiday is a row that exists and is closed, which is not the same as no
  row at all. Both answer "not in session", but only the holiday appears in
  the calendar with a name on it, and only the holiday can be turned back into
  a working day by a PATCH when the fixture is rescheduled.
}
