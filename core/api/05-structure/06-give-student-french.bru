meta {
  name: Give student french
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/subject-enrollments
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "student_enrollment_id": "{{enrollmentId}}",
    "subject_offering_id": "{{electiveOfferingId}}",
    "is_elective_choice": true,
    "enrolled_on": "2026-04-01"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("electiveEnrollmentId", res.body.id);
}
