meta {
  name: Paper object on a note
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/library
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "kind": "note",
    "title": "Revision notes, algebra",
    "audience": "grade",
    "grade_level_id": "{{gradeLevelId}}",
    "paper": {
      "exam_type": "annual",
      "exam_year": 2019
    }
  }
}

assert {
  res.status: eq 422
}

docs {
  Exam metadata only means something on an exam paper. Accepting it on a note
  would put rows in question_papers that no paper search should return and no
  reader could explain, so the pairing is refused outright: a paper object may
  only be sent with kind paper.

  The same check runs on update, in both directions. Turning a paper into a
  note while its exam metadata is still attached is refused too, with a message
  that says to delete the item rather than leave the sidecar behind.
}
