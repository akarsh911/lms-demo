meta {
  name: No register on a holiday
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/attendance/register
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "subject_offering_id": "{{offeringId}}",
    "period_id": "{{periodOneId}}",
    "attendance_date": "2026-11-03",
    "entries": [
      {
        "student_id": "{{studentId}}",
        "status": "present"
      }
    ]
  }
}

assert {
  res.status: eq 422
  res.body.message: contains attendance_not_in_session
}

docs {
  3 November is Founder's Day and both halves are closed. The same refusal
  comes back for a date with no calendar row at all, because absence of a row
  is absence of a school day - so a school whose calendar stops in March
  cannot mark April, which is the failure you want over a year of marks
  against days that never happened.
}
