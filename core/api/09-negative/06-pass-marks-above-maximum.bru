meta {
  name: Pass marks above maximum
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/subject-offerings
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "section_id": "{{sectionId}}",
    "subject_id": "{{subjectId}}",
    "maximum_marks": 50,
    "pass_marks": 90
  }
}

assert {
  res.status: eq 422
}
