meta {
  name: Delete the laboratory
  type: http
  seq: 49
}

delete {
  url: {{baseUrl}}/api/v1/rooms/{{labRoomId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 204
}

docs {
  Rooms last. A room a slot still names cannot be deleted, so this only works
  because the slots went at requests 28 to 31 - and it is the request that
  fails first, with 409, when a previous run of the collection was interrupted
  and left a timetable behind.
}
