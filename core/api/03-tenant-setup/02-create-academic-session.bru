meta {
  name: Create academic session
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/academic-sessions
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "2026-27",
    "code": "2026-27",
    "start_date": "2026-04-01",
    "end_date": "2027-03-31",
    "status": "active",
    "is_current": true
  }
}

assert {
  res.status: eq 201
  res.body.is_current: eq true
}

script:post-response {
  bru.setEnvVar("sessionId", res.body.id);
}

docs {
  Setting is_current demotes every other session; only one may be current.
}
