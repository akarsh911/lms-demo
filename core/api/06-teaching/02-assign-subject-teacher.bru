meta {
  name: Assign subject teacher
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/teacher-assignments
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "teacher_id": "{{teacherId}}",
    "section_id": "{{sectionId}}",
    "subject_offering_id": "{{electiveOfferingId}}",
    "role_type": "subject_teacher",
    "valid_from": "2026-04-01"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("subjectTeacherAssignmentId", res.body.id);
}

docs {
  With a subject_offering_id, this grants sight of only the pupils who
  actually take French, not the whole section.
}
