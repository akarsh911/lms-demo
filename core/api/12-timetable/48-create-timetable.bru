meta {
  name: Create the timetable
  type: http
  seq: 48
}

post {
  url: {{baseUrl}}/api/v1/timetables
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "period_scheme_id": "{{schemeId}}",
    "name": "2026-27 main timetable",
    "version": 1,
    "effective_from": "2026-04-01",
    "status": "draft"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq draft
  res.body.version: eq 1
  res.body.period_scheme_id: eq {{schemeId}}
}

script:post-response {
  bru.setEnvVar("timetableId", res.body.id);
}

docs {
  effective_from is required and effective_to is not: an open-ended timetable
  is the normal case and a closed one is the exception you write when the
  replacement is already known.

  The window is what the resolver uses to decide which timetable is in force
  on a date, so a timetable effective from April covers November without
  anything being said about November.

  supersedes_id points at the version this replaces. It is not set here
  because there is no earlier version, and nothing checks that the superseded
  timetable's window actually ends where this one begins.
}
