meta {
  name: Get academic session
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/academic-sessions/{{sessionId}}
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{sessionId}}
  res.body.code: eq 2026-27
  res.body.is_current: eq true
}

docs {
  A single row comes back bare, with no envelope and no page object. Only
  listings are wrapped.
}
