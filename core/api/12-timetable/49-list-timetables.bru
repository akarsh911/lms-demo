meta {
  name: List draft timetables
  type: http
  seq: 49
}

get {
  url: {{baseUrl}}/api/v1/timetables?academic_session_id={{sessionId}}&status=draft
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.count: gte 1
  res.body.timetables: isArray
}

docs {
  effective_on is the filter that answers "which timetable applies that day":
  it matches rows whose window contains the date, treating a null effective_to
  as open. Filtering by status alone will happily return two overlapping
  published timetables, which is a data problem this route does not police.
}
