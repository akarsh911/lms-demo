meta {
  name: List subjects
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/v1/subjects?elective=true
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 200
  res.body.subjects[0].is_elective: eq true
  res.body.page.limit: eq 50
  res.body.page.offset: eq 0
}

docs {
  elective=true narrows to the subjects a pupil chooses rather than inherits.
  French, created in 03/06, is one. Note what the filter does not do: it is
  ANDed onto the query the caller was already allowed to run, so it can only
  ever return fewer rows than the bare list, never a row the caller could not
  otherwise see.
}
