meta {
  name: A day or a range, not both
  type: http
  seq: 79
}

get {
  url: {{baseUrl}}/api/v1/timetable-occurrences?branch_id={{branchId}}&date=2026-11-02&from=2026-11-02&to=2026-11-09
  body: none
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

assert {
  res.status: eq 400
}

docs {
  from without to is refused as well. Neither silently wins, because a
  dashboard that sends both and gets one is a dashboard that shows the wrong
  week to somebody.
}
