meta {
  name: Update subject group
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/api/v1/subject-groups/{{subjectGroupId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "description": "Choose exactly one of French or Sanskrit"
  }
}

assert {
  res.status: eq 200
  res.body.description: eq Choose exactly one of French or Sanskrit
  res.body.name: eq Second Language
  res.body.status: eq active
}

docs {
  The group is a label, not a rule: nothing here refuses a pupil who picks two
  subjects from the same group. The description says what a human must
  enforce, which is worth knowing before anyone relies on it.
}
