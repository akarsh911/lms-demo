meta {
  name: Update note
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/student-notes/{{staffNoteId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "title": "Strong in algebra",
    "body": "Consistently ahead of the class; ready for the olympiad set."
  }
}

assert {
  res.status: eq 200
  res.body.visibility: eq staff
  res.body.category: eq academic
  res.body.author_person_id: isDefined
}

docs {
  visibility is left out on purpose. Raising a staff note to guardian shows
  the family what was written about their child in the staff room, so it is a
  decision someone takes deliberately, not something an edit of the body
  carries along with it.

  author_person_id is not editable either: it is taken from the caller on
  create and stays. A note whose author could be rewritten is worth nothing as
  a record.

  Reaching this row is narrowed by visibility as well as by pupil, so a
  teacher who may read a guardian-visible note about a pupil they teach still
  gets 404 on a private note about the same pupil.
}
