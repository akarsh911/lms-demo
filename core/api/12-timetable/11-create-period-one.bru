meta {
  name: Create period 1
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/period-schemes/{{schemeId}}/periods
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "name": "Period 1",
    "code": "P1",
    "sequence": 1,
    "kind": "teaching"
  }
}

assert {
  res.status: eq 201
  res.body.code: eq P1
  res.body.kind: eq teaching
  res.body.period_scheme_id: eq {{schemeId}}
}

script:post-response {
  bru.setEnvVar("periodOneId", res.body.id);
}

docs {
  A period has no time on it. sequence is the order periods run in, and the
  clock times arrive later on the bell schedule at request 22. That separation
  is the whole reason bell schedules exist: winter and summer bells are two
  bell schedules over one set of periods, not two sets of periods.

  kind is teaching, break, assembly or other. Only teaching periods carry a
  subject offering on a slot; the break at request 13 is timetabled with a
  label instead.
}
