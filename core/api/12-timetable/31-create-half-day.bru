meta {
  name: Create the half day
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/v1/calendar-days
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "branch_id": "{{branchId}}",
    "calendar_date": "2026-11-04",
    "day_type": "event",
    "forenoon_open": true,
    "afternoon_open": false,
    "name": "Sports meet, forenoon only"
  }
}

assert {
  res.status: eq 201
  res.body.forenoon_open: eq true
  res.body.afternoon_open: eq false
}

script:post-response {
  bru.setEnvVar("halfDayId", res.body.id);
}

docs {
  The half that is open is the half that accepts marks. Folder 13 records a
  forenoon on this date and is refused for the afternoon, and neither answer
  needs a separate flag - it falls out of these two booleans.
}
