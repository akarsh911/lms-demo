# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/seed ./cmd/seed
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/seeddemo ./cmd/seeddemo
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/migrate ./cmd/migrate

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/seed /usr/local/bin/seed
COPY --from=build /out/seeddemo /usr/local/bin/seeddemo
COPY --from=build /out/migrate /usr/local/bin/migrate
COPY migrations /migrations
WORKDIR /
