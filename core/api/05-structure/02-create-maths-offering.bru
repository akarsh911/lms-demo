meta {
  name: Create maths offering
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/subject-offerings
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "academic_session_id": "{{sessionId}}",
    "section_id": "{{sectionId}}",
    "subject_id": "{{subjectId}}",
    "periods_per_week": 6,
    "maximum_marks": 100,
    "pass_marks": 33
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("offeringId", res.body.id);
}
