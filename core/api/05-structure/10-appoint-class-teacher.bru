meta {
  name: Appoint class teacher
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/sections/{{sectionId}}
  body: json
  auth: inherit
}

headers {
  X-School-Id: {{schoolCode}}
}

body:json {
  {
    "class_teacher_id": "{{teacherId}}",
    "capacity": 42
  }
}

assert {
  res.status: eq 200
  res.body.class_teacher_id: eq {{teacherId}}
  res.body.capacity: eq 42
  res.body.code: eq 6-A
}

docs {
  Two different things are easy to confuse here. class_teacher_id on the
  section is who the class belongs to on the timetable. The teacher_assignment
  row created in 06/01 is what actually grants that teacher sight of the
  pupils. Setting this column alone shows a name on a screen and widens
  nobody's access; only the assignment does that.

  capacity is not enforced against the number of enrolments. Nothing refuses a
  43rd pupil in a section of 42.
}
